# Wiyana production-ready environment template
# Copy this file to .env for local development. Never commit real secrets.

ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# Authentication and Telegram
JWT_SECRET=replace-with-a-long-random-secret
TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_ID=
ALLOW_DEV_AUTH=false

# PostgreSQL / Supabase database
DATABASE_URL=postgres://user:password@host:5432/database?sslmode=require
DB_MAX_OPEN_CONNS=25
# Supabase direct hosts (db.<ref>.supabase.co) are IPv6-only and unreachable
# from IPv4-only platforms (Render Oregon, Vercel). The server rewrites them
# automatically to the Supavisor session-mode pooler (always IPv4). Override
# the pooler region if your project lives outside us-east-1.
SUPABASE_POOLER_HOST=aws-0-us-east-1.pooler.supabase.com
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_SECONDS=1800

# Shared state and cache. Use Redis for production and multiple replicas.
STORE_BACKEND=redis
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_SIZE=32
CACHE_ENABLED=true
CACHE_PREFIX=wiyana:cache:
CACHE_TTL_SECONDS=30
CACHE_MAX_ENTRIES=4096
HTTP_RATE_LIMIT_PER_MINUTE=120

# Uploads, HLS and media processing
UPLOAD_DIR=./uploads
HLS_OUTPUT_DIR=./hls_cache
FFMPEG_BINARY=ffmpeg
FFMPEG_WATERMARK_ENABLED=true
PROTECTION_ENABLED=true
PROTECTION_GRANT_TTL_SECONDS=300
PROTECTION_HLS_TTL_SECONDS=300
PLAYBACK_SESSION_TTL_SECONDS=300

# Security policy
PROTECTION_WARNING_THRESHOLD=5
PROTECTION_BAN_THRESHOLD=10
PROTECTION_BAN_DURATION_SECONDS=2592000
PROTECTION_BEHAVIORAL_WINDOW_SECONDS=300
PROTECTION_ESCALATION_VIOLATIONS=3
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional integrations used by selected admin features
IMGBB_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Frontend build-time settings
VITE_API_URL=/api/v1
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_TELEGRAM_BOT_USERNAME=
